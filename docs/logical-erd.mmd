      date appointment_date
      enum status
    }

    TIMESLOT {
      int timeslot_id PK
      int doctor_id FK
      date slot_date
      time start_time
      time end_time
      enum status
    }

    BILLING {
      int billing_id PK
      int appointment_id FK
      int user_id FK
      int processed_by FK
      decimal total_amount
      enum status
    }

    CLINICAL_RECORDS {
      int record_id PK
      int appointment_id FK
      int doctor_id FK
      int patient_id FK
      int submitted_by FK
      enum status
    }

    PATIENT_SCHEDULES {
      int schedule_id PK
      int appointment_id FK
      int user_id FK
      datetime scheduled_start
      datetime scheduled_end
      enum status
    }

    SCHEDULE_REMINDERS {
      int reminder_id PK
      int patient_schedule_id FK
