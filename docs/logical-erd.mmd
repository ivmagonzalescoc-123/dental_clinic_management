    ROLE {
      int role_id PK
      enum role_name
    }

    USERS {
      int user_id PK
      int role_id FK
      int added_by FK
      varchar first_name
      varchar last_name
      varchar email
      bool is_active
      enum work_type
    }

    PATIENTS {
      int patient_id PK
      int added_by FK
      varchar first_name
      varchar last_name
      varchar email
    }

    APPOINTMENTS {
      int appointment_id PK
