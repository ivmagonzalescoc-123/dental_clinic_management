# Cache busting: the chart's ES modules import each other by plain path (no ?v=),
# so force the browser to revalidate them on every load. Unchanged files still
# come back as a cheap 304 Not Modified; re-uploaded files are fetched fresh.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
