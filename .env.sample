# Database Configuration (InfinityFree production)
DB_HOST='localhost'
DB_USER='root'
DB_PASS=''
DB_NAME='capstone_dental'
DB_PORT=3306

# Application Settings
APP_ENV=production
APP_TIMEZONE=Asia/Manila
APP_URL=https://azucenadentalclinic.site.je
RESET_PASSWORD_URL=https://azucenadentalclinic.site.je
# Production security
FORCE_HTTPS=true
SECURE_COOKIES=true
SESSION_LIFETIME=1800
SESSION_DOMAIN=
SESSION_PATH=/

# Brevo — SMS reminders only (email uses Gmail SMTP below)
BREVO_API_KEY=
BREVO_SMS_SENDER=Azucena Dental Clinic
BREVO_SSL_VERIFY=false

# Email delivery (forgot password + appointment reminders): Gmail SMTP
EMAIL_MODE=smtp
REMINDER_EMAIL_MODE=smtp
REMINDER_SMS_MODE=brevo

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=''
SMTP_ENCRYPTION=tls
SMTP_SECURE=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_FROM_NAME=

# Admin Account (Initial Seed — scripts/seed_admin.php)
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

# External Cron (for InfinityFree — trigger reminders via cron-job.org)
# Generate a random string, e.g.: openssl rand -hex 32
CRON_SECRET_KEY=

# Groq AI (free analytics chatbot)
GROQ_API_KEY=

# Google OAuth — Patient "Sign in with Google"
# Get your Client ID from: https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost (local) and your production domain as Authorized JavaScript Origins
GOOGLE_CLIENT_ID='