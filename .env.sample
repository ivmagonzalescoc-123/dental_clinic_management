# Database Configuration (Local XAMPP)
DB_HOST='localhost'
DB_USER='root'
DB_PASS=''
DB_NAME='capstone_dental'
DB_PORT=3306

# Application Settings
APP_ENV=development
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost/capstone_dental
RESET_PASSWORD_URL=http://localhost/capstone_dental
# Local development — no HTTPS
FORCE_HTTPS=true
SECURE_COOKIES=true
SESSION_LIFETIME=1800
# How long (seconds) PHP keeps server-side session data alive with no activity
# anywhere on the site. Must be >= the longest role idle timeout (secretary: 2h)
# or that role's session can be garbage-collected before its own timeout logic
# ever runs. Default: 6 hours.
SESSION_GC_MAXLIFETIME=21600
SESSION_DOMAIN=
SESSION_PATH=/

# Cloudflare Turnstile — bot/spam protection on the login page
# Get real keys at https://dash.cloudflare.com/ -> Turnstile -> Add site (free)
# The values below are Cloudflare's public TEST keys (always pass) — safe for local
# dev only. Replace both with your real site/secret keys before deploying.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# WhatsApp Cloud API (Meta) — booking OTP + appointment reminders
# Get started free at https://developers.facebook.com/apps -> Create App -> add "WhatsApp"
# Create two Message Templates first: "otp_code" (body: "Your Azucena's Dental Clinic
# verification code is {{1}}. It expires in 10 minutes.") and "appointment_reminder"
# (body: "{{1}}"). Leave blank to disable — falls back to email only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=otp_code
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
WHATSAPP_REMINDER_TEMPLATE_LANG=en_US

# Brevo — not used in local dev (set to log mode below)
BREVO_API_KEY=
BREVO_SMS_SENDER=Azucena Dental Clinic
BREVO_SSL_VERIFY=false

# Email/SMS delivery — log mode for local dev (check scripts/send_reminders.log)
# For production, change to: EMAIL_MODE=smtp, REMINDER_SMS_MODE=brevo
EMAIL_MODE=log
REMINDER_EMAIL_MODE=log
REMINDER_SMS_MODE=log
#When deploying, change EMAIL_MODE to smtp and APP_ENV to production — the auto-cron won't run (only in dev mode), so cron-job.org takes over


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=''
SMTP_ENCRYPTION=tls
SMTP_SECURE=tls
SMTP_FROM_EMAIL=noreply@azucenadentalclinic.site.je
SMTP_FROM_NAME="Azucena's Dental Clinic"
REMINDER_EMAIL_FROM=noreply@azucenadentalclinic.site.je
REMINDER_EMAIL_FROM_NAME="Azucena's Dental Clinic"

# Gmail inbox sync (secretary "Check Gmail" button on Contact Us Inquiries)
# Reuses SMTP_USER/SMTP_PASS above — same Gmail account, same App Password.
# Requires the PHP imap extension enabled in php.ini.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Admin Account (Initial Seed — scripts/seed_admin.php)
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

# Cron Secret Key — generate with: openssl rand -hex 32
# Used to trigger: http://localhost/capstone_dental/scripts/cron_reminders.php?key=THIS_VALUE
CRON_SECRET_KEY=dentalclinic_dev_cron_key_2026

# Groq AI (free analytics chatbot)
GROQ_API_KEY=

# Google OAuth — Patient "Sign in with Google"
# Get your Client ID from: https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost (local) and your production domain as Authorized JavaScript Origins
GOOGLE_CLIENT_ID='