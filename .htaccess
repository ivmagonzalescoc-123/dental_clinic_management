# Block access to environment and dependency files if Apache serves this folder.
<FilesMatch "^(\.env|\.env\..*)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(capstone_dental\.sql|\.gitignore)$">
    Require all denied
</FilesMatch>

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-XSS-Protection "1; mode=block"

RewriteEngine On

# One main address for search engines: send the bare domain to https://www.
# (in one hop, before the generic HTTPS rule below). Doesn't affect localhost.
RewriteCond %{HTTP_HOST} ^azucenaclinic\.online$ [NC]
RewriteRule ^ https://www.azucenaclinic.online%{REQUEST_URI} [L,R=301]

# "/index.php" and "/" are the same page; send plain visits to "/" so only one
# address gets indexed. Only bare GETs on the live domain (keeps ?timeout=1, POSTs, localhost).
RewriteCond %{HTTP_HOST} ^www\.azucenaclinic\.online$ [NC]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ https://www.azucenaclinic.online/ [L,R=301]

# Force HTTPS on live hosts (skip local XAMPP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct web access to internal folders
RewriteRule ^config/ - [F,L]
RewriteRule ^docs/ - [F,L]
RewriteRule ^ws-server/ - [F,L]
RewriteRule ^backups/ - [F,L]

# Cache busting: PHP pages are never cached (so browsers always see the newest
# ?v=<mtime> asset URLs from config/asset_helpers.php), while versioned CSS/JS
# can be cached long-term because a re-upload changes their URL.
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
